# ============================================
# CyberStrikeAI 配置文件
# ============================================
# 本配置文件支持通过 Web 界面进行可视化配置
# 点击右上角"设置"按钮即可修改配置
# ============================================

# ============================================
# 系统设置
# ============================================

# 前端显示的版本号（可选，不填则显示默认版本）
version: "v1.8.0"
# 服务器配置
server:
  host: 0.0.0.0 # 监听地址，0.0.0.0 表示监听所有网络接口
  port: 8080 # 服务端口
  # --- 可选：HTTPS + HTTP/2（缓解浏览器对同源 HTTP/1.1 的并发连接数限制，多路 Deep 流式更稳）---
  # 启用 TLS 的条件（满足其一即可）：tls_enabled: true，或 tls_auto_self_sign: true，或同时配置了 tls_cert_path + tls_key_path。
  # 启用后请用 https://127.0.0.1:<本端口>/ 访问；若仍用 http:// 访问同端口，将自动 308 跳转到 HTTPS（可用 tls_http_redirect: false 关闭）。
  tls_enabled: true
  # 启用 HTTPS 时，明文 HTTP 是否自动跳转到 HTTPS（默认 true；同端口嗅探 TLS/HTTP 后分流）
  # tls_http_redirect: true
  # 方式 A（推荐生产）：PEM 证书与私钥路径
  # tls_cert_path: /path/to/fullchain.pem
  # tls_key_path: /path/to/privkey.pem
  # 方式 B（仅本地/测试）：无证书文件时内存自签（浏览器会提示不受信任；SAN 含 localhost / 127.0.0.1）
  tls_auto_self_sign: true
# 认证配置
auth:
  password: "Zw123456@" # Web 登录密码，请修改为强密码
  session_duration_hours: 12 # 登录有效期（小时），超时后需重新登录
# 日志配置
log:
  level: info # 日志级别: debug(调试), info(信息), warn(警告), error(错误)
  output: stdout # 日志输出位置: stdout(标准输出), stderr(标准错误), 或文件路径
# 平台操作审计（系统设置 -> 日志审计；不记录对话正文与每次工具调用）
audit:
  enabled: true
  retention_days: 15 # 0 表示不自动清理
  max_detail_bytes: 8192
  auth_failure_cooldown_seconds: 60 # 同一 IP 登录/改密失败审计最短间隔（秒）；未配置时默认 60；-1 关闭节流
# ============================================
# 对话相关配置
# ============================================

# ============================================
# 信息收集（FOFA）配置（可选）
# ============================================
# 用于「信息收集」页面 + Agent 工具 fofa_search（密钥只放配置/环境变量，不写死在代码里）
# 环境变量优先级更高：
#   FOFA_EMAIL / FOFA_API_KEY / FOFA_BASE_URL
#   FOFA_BEARER_TOKEN / FOFA_AUTH_MODE / FOFA_VERIFY_SSL
#   FOFA_FALLBACK_BASE_URLS / FOFA_TIMEOUT_SECONDS
#
# base_url 留空默认官方；若使用兼容 search 接口，填该服务完整 URL，并保证 api_key 与之匹配。
fofa:
  base_url: "" # 留空默认 https://fofa.info/api/v1/search/all
  api_key: ""
  auth_mode: auto # auto | key | bearer
  bearer_token: ""
  # verify_ssl 省略=自动；连通异常时可显式 false
  # verify_ssl: false
  timeout_seconds: 30
  fallback_base_urls: []
# Agent 配置
# 达到最大迭代次数时，AI 会自动总结测试结果
agent:
  max_iterations: 12000 # 最大迭代次数，AI 代理最多执行多少轮工具调用（Deep/Plan-Execute/Supervisor 等；eino_single 见下方专属配置）
  large_result_threshold: 102400 # 大结果阈值（字节），默认50KB，超过此大小会自动保存到存储
  result_storage_dir: tmp # 结果存储目录，大结果会保存在此目录下
  tool_timeout_minutes: 60 # 单次工具执行最大时长（分钟），超时自动终止；0 表示不限制（不推荐，易出现长时间挂起）
  # system_prompt_path: prompts/single-react.md # 可选：单代理系统提示文件（相对本配置文件所在目录）；非空且可读时替换内置提示

  system_prompt_path: ""
  # eino_single 专属执行控制（不影响 Deep / Plan-Execute / Supervisor / 子 Agent）
  # 省略整块或省略字段时使用下列默认；enabled=false 关闭义务/批次/停滞门，仍保留 run 超时与 shell 有界回收
  eino_single_execution:
    enabled: true # false：回滚义务与工具批次重写
    max_iterations: 200 # 单 ADK 最大迭代
    run_timeout_minutes: 120 # 整次 run 绝对 deadline；中断续跑不延期
    model_call_timeout_seconds: 300 # 单次模型调用上限（受 run 剩余时间压缩）
    model_stream_idle_timeout_seconds: 120 # 模型流式分片空闲超时
  tool_wait_timeout_seconds: 0
  external_mcp_max_concurrent_per_server: 0
  external_mcp_max_concurrent_total: 0
  external_mcp_circuit_failure_threshold: 0
  external_mcp_circuit_cooldown_seconds: 0
# 人机协同（HITL）全局白名单：此处列出的工具始终免审批，与对话页「白名单工具（免审批，逗号分隔）」合并为并集；侧栏「应用」可合并写入本列表并立即生效。
hitl:
  # 按你环境里的真实工具名增删（与侧栏一致、小写不敏感）；不需要全局免审批可改为 []
  tool_whitelist: [read_file, list_dir, glob, grep, list_project_facts, search_project_facts, get_asset, query_assets, list_vulnerabilities, get_vulnerability, list_knowledge_risk_types, get_tool_execution, wait_tool_execution, batch_task_list, batch_task_get]
  audit_model:
    provider: ""
    base_url: ""
    api_key: ""
    model: cyberdriver
  default_reviewer: audit_agent
  retention_days: 90
  audit_agent_prompt: |-
    你是 CyberStrikeAI 人机协同审计 Agent。你的职责是审查 Agent 即将执行的工具调用，判断该操作是否可能对目标系统、数据、账
      号、服务或网络环境造成实质性损害。

      你会收到 JSON，可能包含以下字段：

      - hitlMode
      - toolName
      - arguments
      - argumentsObj
      - userMessage
      - thinking
      - reasoningChain
      - planning
      - 其他与任务目标、授权范围、执行环境有关的字段

      ## 审查原则

      裁决基调为：默认放行，精准拦截高风险操作。

      - 常规、低风险、可逆或只读的安全测试操作，默认 approve
      - 与用户授权范围、当前任务目标一致，且没有明确高危迹象的操作，默认 approve
      - 不因命令看起来“像安全测试”、参数较宽泛、信息不完整而直接拒绝
      - 只有存在明确、现实且可能造成实质影响的风险时，才 reject
      - 审查对象是“即将执行的工具调用本身”，不是 Agent 的全部思路、历史行为或推测性意图
      - 若工具调用本身无破坏性，但上下文存在轻微疑点，仍应 approve，并在 comment 中提示限制范围、避免生产执行、保留日志等注
        意事项

      - 不得将“缺少信息”“可能存在风险”“目标未知”作为唯一拒绝理由；除非调用已具备明确高危或明显越权特征

      ## 应当 approve 的情形

      以下情况通常应裁决为 approve：

      - 信息收集、资产发现、域名解析、子域枚举、指纹识别
      - 端口扫描、服务探测、版本识别、TLS/HTTP/DNS 查询
      - 目录枚举、接口枚举、参数探测、Swagger/OpenAPI 文档发现
      - 只读数据库查询、日志读取、配置读取、文件读取、代码检索
      - curl、wget、nmap、nslookup、dig、ping、traceroute、grep、rg、find 等常规命令
      - 低频率、低并发、无写入影响的漏洞验证
      - 对授权目标的请求重放、响应对比、参数变异、认证与授权边界测试
      - 使用 Burp、Yakit、Nuclei、浏览器开发者工具进行非破坏性验证
      - 在本地、测试、靶场、容器或用户明确授权的环境中执行的构建、测试、启动和调试操作
      - 对本地工作区内项目文件的正常开发修改、配置调整、依赖安装和测试运行
      - 参数范围略宽，但调用本身没有删除、写入、停服、提权、恶意载荷或批量资源消耗意图的操作

      ## 必须 reject 的高危情形

      以下情况应裁决为 reject：

      - 删除数据库、清空表、批量删除文件、递归删除目录、格式化磁盘
      - 覆盖重要配置、覆盖生产数据、不可恢复地修改数据或日志
      - 重置、修改、禁用密码、MFA、账号绑定、访问令牌或凭证
      - 创建、提权、篡改管理员账号、服务账号、云账号、数据库账号
      - 写入 WebShell、后门、木马、远控程序、持久化脚本或恶意计划任务
      - 配置开机自启、注册表持久化、计划任务持久化、服务持久化
      - 停止、重启、禁用关键生产服务、数据库、中间件、网络设备或安全设备
      - 修改防火墙、安全组、ACL、路由、DNS、代理、证书、系统核心安全配置
      - 向生产环境投放恶意载荷、勒索加密、挖矿、拒绝服务流量或高强度资源消耗任务
      - 主动外传敏感数据、批量导出用户数据、凭证、密钥、数据库内容或业务数据
      - 明显超出用户授权目标的横向移动、攻击无关资产、访问第三方系统
      - 利用已发现漏洞执行破坏性利用、写入利用、权限提升或持久化行为
      - 任何明确具有破坏性、不可逆性、业务中断风险或超出授权边界的调用

      ## 重点审查维度

      2. 操作是否可能影响生产服务可用性、数据完整性、账号安全或网络稳定性。
      3. 操作是否可逆；不可逆操作需要更严格审查。
      4. 操作目标是否属于用户当前明确授权的系统、项目、目录、域名或环境。
      5. 操作是否具有批量性、高并发性、递归性、全局性或资源耗尽风险。
      6. 操作是否涉及敏感凭证、个人信息、业务数据、密钥或内部配置。
      7. 操作是否只是验证漏洞，还是已进入利用、写入、持久化、破坏阶段。
      8. 调用是否存在明显绕过授权、扩大攻击面或攻击无关目标的行为。

      ## 边界裁决规则

      - 仅扫描、枚举、读取、探测、验证：approve
      - 有限写入但仅作用于本地测试环境，且与当前开发或测试任务一致：approve
      - 对生产环境执行状态变更、批量写入、删除、停服、权限修改：reject
      - 命令参数较宽泛但没有明确破坏动作：approve
      - 信息不足但未出现高危行为：approve
      - 用户明确授权安全测试，但操作涉及不可逆破坏、持久化、账号篡改或业务中断：仍然 reject
      - 若调用可以通过收窄目标、限制并发、去除写入参数而降低风险，可 approve 并在 comment 中提出限制建议；但工具调用本身已经
        包含高危动作时必须 reject

      ## 输出要求

      仅输出一行 JSON，不要 Markdown，不要代码块，不要补充说明：

      {"decision":"approve"|"reject","comment":"简要、明确的裁决理由"}

      ## 输出示例

      {"decision":"approve","comment":"只读 HTTP 探测，属于常规低风险信息收集，未见写入或破坏性行为。"}

      {"decision":"approve","comment":"端口与服务识别属于授权范围内的低影响扫描；建议限制并发并避免对生产高峰期执行。"}

      {"decision":"reject","comment":"调用包含批量删除数据库记录的操作，可能造成不可逆数据损失。"}

      {"decision":"reject","comment":"调用尝试创建高权限账号并配置持久化，存在明显的权限篡改和后门风险。"}
  audit_agent_prompt_review_edit: |-
    • 你是 CyberStrikeAI 人机协同审计 Agent。审查 Agent 即将执行的工具调用是否会对系统造成实质性损害，并在可安全收窄参数时提
      供编辑后的参数。

      你会收到 JSON，可能包含 hitlMode、toolName、arguments、argumentsObj、userMessage、thinking、reasoningChain、planning、
      任务目标、授权范围、环境信息等字段。

      裁决基调（默认放行）：

      - 常规、低风险、只读、可逆的渗透测试与开发运维操作 → approve
      - 与用户授权、当前任务目标一致，且未见明确高危迹象 → approve
      - 仅在调用可能造成实质性影响、不可逆损害、业务中断、权限篡改、恶意写入或明显越权时 → reject
      - 不因工具名称、参数略宽、目标环境未知或信息不足而单独拒绝
      - 审查对象是本次即将执行的工具调用本身，不应基于推测性意图扩大拒绝范围

      应当 approve 的常见情形：

      - 信息收集：域名解析、子域枚举、资产发现、指纹识别、证书查询、DNS/WHOIS 查询
      - 网络探测：端口扫描、服务识别、版本识别、TLS/HTTP/DNS 探测、路由追踪
      - Web 枚举：目录枚举、接口发现、参数发现、Swagger/OpenAPI 文档读取、静态资源检索
      - 只读查询：读取代码、日志、配置、文件、数据库元数据、只读数据库查询
      - 常规命令：nmap、curl、wget、nslookup、dig、ping、traceroute、rg、grep、find、Get-Content、Get-ChildItem
      - 低频率、低并发、无状态变更的漏洞验证、请求重放、响应差异比对、认证与授权边界测试
      - 使用 Burp、Yakit、浏览器、HTTP 客户端、扫描器进行无害探测
      - 用户授权范围内的本地构建、测试、调试、依赖安装、项目文件开发修改
      - 参数较宽但未包含写入、删除、提权、持久化、恶意载荷、外传或资源耗尽行为的调用

      必须 reject 的高危情形（示例，非穷举）：

      - 删库、删表、清表、DROP、TRUNCATE、批量 DELETE、批量覆盖生产数据
      - 递归删除文件、删除关键目录、覆盖关键配置、格式化磁盘、擦除数据、不可逆加密
      - 修改、重置、禁用密码、MFA、认证方式、Token、Cookie、恢复方式
      - 创建、删除、篡改管理员账号、高权限服务账号、数据库账号、云账号或权限策略
      - 权限提升、修改 RBAC/IAM/ACL、安全组、防火墙、路由、DNS、代理、证书或核心安全配置
      - 写入 WebShell、后门、木马、远控程序、挖矿程序、恶意脚本或持久化组件
      - 创建计划任务、Cron、系统服务、开机自启、注册表自启动等持久化机制
      - 向生产环境上传、执行或部署恶意载荷
      - 停止、禁用、重启关键生产服务、数据库、中间件、消息队列、缓存、负载均衡或安全设备
      - 发起拒绝服务、洪泛、高并发资源耗尽、无限递归、批量爆破等可能影响可用性的操作
      - 批量导出、外传、传播敏感数据、源代码、密钥、凭证、用户数据或业务数据
      - 明显越权：对授权目标以外的资产、账号、网络、项目或第三方系统执行破坏性、提权性或写入性操作
      - 已从漏洞验证进入实际利用、横向移动、账号接管、持久化、数据窃取或业务破坏阶段

      不应单独作为 reject 理由的情形：

      - 常规 nmap、curl、grep、rg、读文件、读日志、目录枚举、接口枚举类命令
      - 参数略显宽泛但没有明确破坏意图
      - 工具本身具备高风险能力，但本次调用未使用对应危险参数
      - 仅因目标可能是生产环境，但调用实际为只读、低频率、低影响探测
      - 仅因信息不足、授权描述不完整或存在一般性风险猜测
      - 常规漏洞验证，但未包含写入、删除、停服、提权、持久化、外传或高并发消耗行为

      审查编辑模式：

      审查编辑模式下，审计 Agent 可在不改变原始任务核心目标的前提下，通过 editedArguments 对参数进行最小必要修改，收窄范围、
      移除非必要危险参数后放行。

      仅当满足以下条件时，允许 approve 并输出 editedArguments：

      - 原始调用不包含必须直接拒绝的高危核心行为
      - 风险来自可独立收敛的参数，而不是调用本身的目标
      - 修改后仍能完成用户当前授权范围内的合理任务
      - 修改不会扩大攻击面、目标范围、权限范围、扫描强度、写入能力或资源消耗
      - 可以提供完整、可直接替换的参数对象

      可编辑放行的常见方式：

      - 将泛域名、网段、目录、文件路径收窄到用户明确授权的目标
      - 将全端口扫描收窄至指定端口、常用端口或明确服务端口
      - 降低扫描并发、请求速率、递归深度、超时时间、重试次数、批量规模
      - 移除删除、覆盖、强制执行、上传、写入、跟随危险重定向等非必要标志
      - 将数据库操作收窄为只读查询，并增加明确库表、条件、分页或 LIMIT
      - 将可能触发状态变更的 HTTP 请求改为只读方法，或禁止自动提交、自动跟随重定向
      - 将文件检索限制为当前工作区、指定项目目录或已授权文件
      - 移除无关目标、额外凭证、回连地址、危险载荷、无关代理或扩展选项

      editedArguments 规则：

      - 仅在 decision 为 approve 且确有必要改参时填写；否则省略该字段
      - 提供完整替换后的工具参数对象，键名与 argumentsObj 一致
      - 仅做最小必要修改，保留原任务中安全且必要的参数
      - 禁止扩大攻击面：不得新增目标、网段、端口、路径、账号、权限、载荷或执行能力
      - 禁止提高并发、扩大字典、增加递归深度、延长爆破时间、增加请求量
      - 禁止引入写入、删除、上传、提权、持久化、外传、恶意执行或拒绝服务参数
      - 不得只返回局部变更；必须返回完整可替换参数对象
      - 无法安全改参时应 reject，不得勉强 approve

      无法通过编辑模式放行、必须 reject 的情形：

      - 高危动作本身就是调用的核心目标
      - 删除、覆盖、加密、格式化、停服、重置密码、账号篡改、持久化、恶意载荷或外传无法通过删除少量参数消除
      - 修改后仍可能造成不可逆数据损失、业务中断、权限变更或安全边界破坏
      - 无法将操作目标收窄到当前用户授权范围
      - 调用明显超出任务目标，且涉及无关资产的攻击、写入、提权或破坏
      - 所谓“安全改参”实质上改变了用户任务本身；此时应拒绝原调用，而不是重写任务

      裁决步骤：

      1. 判断调用是读取、探测、扫描、验证、写入、删除、提权、持久化、停服还是外传。
      2. 判断是否会影响数据完整性、服务可用性、账号权限、系统安全、网络稳定性或授权边界。
      3. 若存在明确高危行为，直接 reject。
      4. 若无高危行为但参数可安全收窄，输出 approve 和完整 editedArguments。
      5. 若无高危行为且无需改参，直接 approve。
      6. comment 仅简要说明放行、拒绝或改参的直接理由。

      仅输出一行 JSON，不要 Markdown 代码块，不要额外说明：

      {"decision":"approve"|"reject","comment":"简要理由","editedArguments":{...}}
  default_mode: off
  default_timeout_seconds: 300
  audit_backend: openai
# 多代理（CloudWeGo Eino DeepAgent，与上方单 Agent /api/agent-loop 并存）
# 依赖在 go.mod 中拉取；若下载失败可设置: go env -w GOPROXY=https://goproxy.cn,direct
# 启用后需重启服务才会注册 /api/multi-agent 与 /api/multi-agent/stream；Deep / Plan-Execute / Supervisor 由对话页与 WebShell 所选模式在请求体中传入；机器人按 robot_default_agent_mode
multi_agent:
  enabled: true
  robot_default_agent_mode: eino_single # 企微/钉钉/飞书机器人默认对话模式：react | eino_single | deep | plan_execute | supervisor
  batch_use_multi_agent: false # true 时「批量任务」队列中每个子任务也走 Eino 多代理（成本更高）
  max_iteration: 0 # 主代理 / plan_execute 执行器最大轮次，0 表示沿用 agent.max_iterations
  # plan_execute 专用：execute↔replan 外层循环上限，0 表示 Eino 默认 10。当前实现下 Executor 会挂载 patch/reduction/tool_search 等前置中间件。
  plan_execute_loop_max_iterations: 0
  sub_agent_max_iterations: 120
  sub_agent_user_context_max_runes: 0 # 子代理 task 描述中自动注入用户原始请求的字符上限；0=默认2000，负数=禁用
  without_general_sub_agent: false # false 时保留 Deep 内置 general-purpose 子代理
  without_write_todos: false
  orchestrator_instruction: "" # Deep 主代理：agents/orchestrator.md（或 kind: orchestrator 的单个 .md）正文优先；正文为空时用此处；皆空则 Eino 默认
  orchestrator_instruction_plan_execute: "" # plan_execute 主代理：agents/orchestrator-plan-execute.md 正文优先；正文为空时用此处；皆空则用内置 plan_execute 提示（不使用 Deep 的 orchestrator_instruction）
  orchestrator_instruction_supervisor: "" # supervisor 主代理：agents/orchestrator-supervisor.md 正文优先；正文为空时用此处；皆空则用内置 supervisor 提示（transfer/exit 说明仍由运行追加；不使用 Deep 的 orchestrator_instruction）
  # Eino 官方 Skills：渐进式披露 + 可选本机文件/Shell（eino-ext local backend）。Skills 目录见 skills_dir。
  eino_skills:
    catalog_profile: src
    disable: false # true：不注册 skill 渐进式披露中间件，也不挂本机 FS/Shell 工具；false：按下方开关加载
    filesystem_tools: true # true：注册 read_file/glob/grep/write/edit/execute（授权环境慎用）；false：仅 skill，不暴露本机读写与 Shell
    skill_tool_name: skill # 模型侧可调用的「加载技能」工具名，一般保持 skill；与技能包文档中的调用名一致即可
  # Eino ADK 中间件与 Deep/Supervisor 调参（结构体见 internal/config/config.go → MultiAgentEinoMiddlewareConfig）
  eino_middleware:
    summarization_output_reserve_tokens: 8192
    patch_tool_calls: true # true：修补历史中无 tool_result 的悬空 tool_call（流式中断/重试后更稳）；false：关闭；字段省略时默认等同 true
    tool_search_enable: true # true：工具数 ≥ min 时启用 tool_search，仅前 N 个工具常驻，其余按正则按需解锁，省 token、减误选；false：全量工具进上下文
    tool_search_min_tools: 20 # 达到该数量才启用 tool_search（避免工具很少时多此一举）；与 always_visible 配合使用
    tool_search_always_visible: 12 # 始终直接暴露给模型的工具个数（顺序与角色工具列表一致）；其余工具进入动态池，需 tool_search 解锁
    tool_search_always_visible_tools: [read_file, glob, grep, write_file, edit_file, execute, task, transfer_to_agent, exit, write_todos, skill, tool_search, TaskCreate, TaskGet, TaskUpdate, TaskList, record_vulnerability, list_vulnerabilities, get_vulnerability, list_knowledge_risk_types, search_knowledge_base, webshell_exec, webshell_file_list, webshell_file_read, webshell_file_write, manage_webshell_list, manage_webshell_add, manage_webshell_update, manage_webshell_delete, manage_webshell_test, batch_task_list, batch_task_get, batch_task_start, batch_task_rerun, batch_task_pause, batch_task_update_metadata, batch_task_update_schedule, batch_task_schedule_enabled, batch_task_update_task, batch_task_remove_task, batch_task_delete, batch_task_create, batch_task_add_task, http-framework-test, nmap, rustscan] # 后端内置常驻工具白名单（优先于 always_visible 数量策略）
    # --- 挖洞执行增强（execution_boost / src_hunter_runtime）---
    # 默认开启：合并核心挖洞工具 always_visible、SkillRouter、task 证据附加、reduction 排除默认、L1 candidate 配套运行时。
    # 一键关闭：execution_boost: false  或  src_hunter_runtime.enable: false（详见 docs/EXECUTION_BOOST.md）
    execution_boost: true
    src_hunter_runtime:
      enable: true # 覆盖 execution_boost；false 关闭全部增强
      skill_router: true # 工具结果自动注入 Top skill 要点
      task_evidence_k: 5 # task 附加最近 K 次工具结构化摘要
    skill_router_enable: true
    skill_router_top_k: 3
    skill_router_max_runes: 3500
    # 第二轮：扫描器结果置顶结构化摘要预算（runes，默认 1200，建议 800–1500；≤0 回落默认，>8000 钳到 8000）
    structured_summary_max_runes: 1200
    # 第二轮：收工半硬门闩（open P0/P1 + 无洞话术 → finalize_gate_blocked）；nil 跟随 execution_boost；false 关闭
    finalize_gate_enable: true
    # 第三轮：代码层健全——会话 coverage/evidence 有上限与并发锁；finalize 双出口（正常+部分错误）统一 maybeApplyFinalizeGate；
    # Effective() 对非法负值/过大 TopK 钳制。验收只跑单测即可，见 docs/EXECUTION_BOOST.md 第三节。
    task_evidence_k: 5
    task_require_target: true
    plantask_enable: false # true：主代理（Deep / Supervisor 主）挂载 TaskCreate/Get/Update/List；需 eino_skills 可用且 skills_dir 存在，否则仅打日志并跳过
    plantask_rel_dir: .eino/plantask # 结构化任务文件相对 skills_dir 的子目录，其下再按会话 ID 分子目录存放
    reduction_enable: true # true：大工具输出截断/落盘以控上下文；依赖与 plantask 相同的 eino local 写盘后端，无后端时不挂载
    reduction_max_length_for_trunc: 50000 # 单条工具结果超过该字符数（bytes）时截断并落盘（由 reduction 中间件处理）
    reduction_max_tokens_for_clear: 160000 # 历史工具结果清理阈值（tokens），超阈值时在模型调用前清理旧结果
    reduction_root_dir: "" # 非空：截断/清理内容落盘根路径；空：使用系统临时目录下按会话隔离的默认路径
    reduction_clear_exclude: [] # 生产在 execution_boost 下自动合并 sqlmap/nuclei/http-framework-test/dalfox/execute-python-script 等；可在此追加
    reduction_sub_agents: true # true：子代理也挂 reduction；false：仅编排主代理使用 reduction
    summarization_trigger_ratio: 0.8 # summarization 触发比例（max_total_tokens * ratio），建议 0.75~0.85
    summarization_emit_internal_events: true # true：发出 summarization 内部事件（便于诊断）
    history_input_budget_ratio: 0.35 # 历史入队预算比例（max_total_tokens * ratio）
    plan_execute_user_input_budget_ratio: 0.35 # plan_execute 中 userInput 预算比例（planner/replanner/executor 共用）
    plan_execute_executed_steps_budget_ratio: 0.2 # plan_execute 中 executed_steps 预算比例
    plan_execute_max_step_result_runes: 4000 # plan_execute 每步结果最大字符数（超出截断）
    plan_execute_keep_last_steps: 8 # plan_execute 仅保留最近 N 步正文，早期步骤折叠为标题
    checkpoint_dir: "" # 非空：为 adk.NewRunner 启用按会话子目录的文件型 CheckPointStore，便于中断恢复持久化；Resume 的 HTTP/前端流程需另行对接
    run_retry_max_attempts: 0 # >0：429/5xx/网络抖动时 ADK 运行循环指数退避续跑次数；0=默认 10
    run_retry_max_backoff_sec: 0 # 单次退避上限秒数；0=默认 30
    deep_output_key: "" # 非空：将最终助手输出写入 adk session 的键名（Deep 与 Supervisor 主代理）；空表示不写入
    deep_model_retry_max_retries: 0 # >0：ChatModel 调用失败时的框架级最大重试次数（Deep 与 Supervisor 主）；0：不重试
    task_tool_description_prefix: "" # 非空：仅 Deep 的 task 工具使用自定义描述前缀，运行时会拼接子代理名称；空则走 Eino 默认生成逻辑
    # --- 工具执行治理（Execution Plane）：并发上限、MCP per-call 超时、命令层超时注入、wall-clock 总上限 ---
    # 默认开启 + 保守值；一键关闭：tool_exec_governor.enable: false（恢复增强前行为，详见 docs/EXECUTION_BOOST.md 第五节）
    # 解决痛点：MCP 工具（nmap/nuclei/sqlmap）原无 per-call 超时 + 框架无限并行 wait-all，单个挂死工具拖死整轮 Agent。
    tool_exec_governor:
      enable: true # nil/true=开；false 关闭全部治理
      max_concurrent: 5 # 每会话工具并发上限；负数=不限；默认 5（防一轮无限并行被单个挂死工具拖死）
      mcp_per_call_timeout_sec: 600 # MCP 工具 per-call 超时秒；负数=不限；默认 600；按工具分档可在 per_tool_timeout_sec 覆盖
      inject_cmd_timeout: true # 对 curl/wget 在未指定 --max-time 时注入 --max-time 60 --connect-timeout 10（防 TCP 半开连接无限等）
      max_wall_clock_sec: 300 # exec/execute 单次工具调用 wall-clock 总上限秒；负数=不限；默认 300；与 inactivity（无输出空闲）互补
      per_tool_timeout_sec: # 按工具名覆盖 per-call 超时（秒；键名小写）；未列出者用默认档位（recon600/scanner900/exploit1800）
        nmap: 600
        nuclei: 900
        sqlmap: 1800
    summarization_user_intent_ledger_max_runes: 96000
    summarization_user_intent_ledger_entry_max_runes: 16000
    latest_user_message_max_runes: 48000
    latest_user_message_head_runes: 24000
    latest_user_message_tail_runes: 24000
    model_retry_max_retries: 0
    model_retry_max_backoff_sec: 0
    model_failover_channels: []
    model_failover_max_retries: 0
